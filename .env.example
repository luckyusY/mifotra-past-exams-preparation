# MongoDB Atlas connection string.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="mifotra"

# Random 32+ byte secret used to sign access sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Password for /admin, where access codes are generated.
ADMIN_PASSWORD=""

# Public site URL, used for sitemap and canonical tags.
NEXT_PUBLIC_SITE_URL="https://mifotra-past-exams-preparation.vercel.app"

# Blog generator. Whichever key is present is used; OpenAI wins if both are set.
OPENAI_API_KEY=""
